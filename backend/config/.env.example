# Jasefly secrets — NEVER commit real values.
# File is blocked from HTTP (api/config/.htaccess + root RewriteRule).
# Copy to .env and fill. Values do not override real OS environment variables.

APP_NAME=Jasefly
APP_URL=https://YOUR_DOMAIN
APP_ENV=production
APP_TIMEZONE=Europe/Moscow

JWT_SECRET=YOUR_JWT_SECRET
JWT_TTL=3600
REFRESH_TTL=604800

# MCP agent token (Authorization: Bearer …) — preferred over admin password
MCP_API_TOKEN=YOUR_MCP_TOKEN
# Second secret for HMAC (X-Jasefly-Sign). Never put on the wire. Same value in mcp-cms CMS_SITE_*_SIGNING_SECRET.
MCP_SIGNING_SECRET=
# legacy (Bearer only) | prefer (warn unsigned) | require (unsigned MCP → 401). Empty signing secret forces legacy.
MCP_AUTH_MODE=legacy
# Optional: comma-separated IPs/CIDRs allowed for MCP (empty = off)
MCP_ALLOWED_IPS=
# Max |now - X-Jasefly-Ts| seconds
MCP_SKEW_SECONDS=300

# Opt-in: CMS update ZIP waits for Telegram Approve (0=apply immediately)
TELEGRAM_DEPLOY_APPROVE=0
TELEGRAM_DEPLOY_BOT_TOKEN=
TELEGRAM_DEPLOY_CHAT_ID=
# Random secret for setWebhook secret_token (≠ bot token)
TELEGRAM_DEPLOY_WEBHOOK_SECRET=
TELEGRAM_DEPLOY_TTL_SECONDS=3600

BACKUP_KEY=
CORS_ORIGINS=https://YOUR_DOMAIN
UPLOAD_MAX_MB=10

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jasefly_cms
DB_USER=YOUR_DB_USER
DB_PASS=YOUR_DB_PASSWORD
DB_CHARSET=utf8mb4
# DB_PATH=storage/sqlite/cms.sqlite
