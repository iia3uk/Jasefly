# Jasefly secrets — NEVER commit real values.
# File is blocked from HTTP (api/config/.htaccess + root RewriteRule).
# Copy to .env and fill. Values do not override real OS environment variables.

APP_NAME=Jasefly
APP_URL=https://YOUR_DOMAIN
APP_ENV=production
APP_TIMEZONE=Europe/Moscow

JWT_SECRET=YOUR_JWT_SECRET
JWT_TTL=3600
REFRESH_TTL=604800

# MCP agent token (Authorization: Bearer …) — preferred over admin password
MCP_API_TOKEN=YOUR_MCP_TOKEN

BACKUP_KEY=
CORS_ORIGINS=https://YOUR_DOMAIN
UPLOAD_MAX_MB=10

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jasefly_cms
DB_USER=YOUR_DB_USER
DB_PASS=YOUR_DB_PASSWORD
DB_CHARSET=utf8mb4
# DB_PATH=storage/sqlite/cms.sqlite
