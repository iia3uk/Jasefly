{
  "name": "@jasefly/runtime-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "argon2": "^0.41.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.7",
    "fflate": "^0.8.3",
    "hono": "^4.7.5",
    "jose": "^6.0.10",
    "mysql2": "^3.14.0",
    "otplib": "^12.0.1",
    "pg": "^8.14.1",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true
  }
}
