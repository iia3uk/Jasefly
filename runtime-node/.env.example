APP_NAME=Jasefly
APP_URL=http://localhost:3080
APP_ENV=production
APP_TIMEZONE=Europe/Moscow
PORT=3080
JWT_SECRET=change-me-long-random
JWT_TTL=3600
REFRESH_TTL=604800
MCP_API_TOKEN=
# Dual-secret MCP (same contract as PHP). Empty signing secret → legacy Bearer-only.
MCP_SIGNING_SECRET=
MCP_AUTH_MODE=legacy
MCP_ALLOWED_IPS=
MCP_SKEW_SECONDS=300

# Opt-in: VPS SSH deploy waits for Telegram Approve (secrets only here, not mcp-cms)
TELEGRAM_DEPLOY_APPROVE=0
TELEGRAM_DEPLOY_BOT_TOKEN=
TELEGRAM_DEPLOY_CHAT_ID=
TELEGRAM_DEPLOY_WEBHOOK_SECRET=
TELEGRAM_DEPLOY_TTL_SECONDS=3600

CORS_ORIGINS=*
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jasefly
DB_USER=jasefly
DB_PASS=
DB_PATH=./storage/sqlite/cms.sqlite
STORAGE_PATH=./storage
RUNTIME=node-vps
