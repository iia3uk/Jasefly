{
  "title": "Updates",
  "slug": "updates",
  "seo_title": "Updating Jasefly — Safe SiteUpdater Releases",
  "seo_description": "How to update a Jasefly site safely: backup, apply update ZIP via SiteUpdater, migrations, quarantine awareness, and post-deploy checks.",
  "layout": {
    "version": 1,
    "meta": { "product": "jasefly-official", "revision": "framework-first-2026-08-02" },
    "elements": [
      {
        "id": "s_up_hero",
        "elType": "section",
        "settings": { "paddingY": "3.5rem", "gap": "1.5rem", "columns": 1 },
        "elements": [
          {
            "id": "c_up_hero",
            "elType": "column",
            "settings": { "width": 100 },
            "elements": [
              {
                "id": "w_up_h1",
                "elType": "widget",
                "widgetType": "heading",
                "settings": { "text": "Safe updates", "tag": "h1", "size": "2xl", "align": "left" }
              },
              {
                "id": "w_up_intro",
                "elType": "widget",
                "widgetType": "text",
                "settings": {
                  "html": "<p>Production sites update through <strong>SiteUpdater</strong> and managed release ZIPs (including <code>cms_release</code> from MCP). The goal is predictable deploys on shared hosting — backup first, apply the package, verify the site.</p>",
                  "align": "left"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "s_up_steps",
        "elType": "section",
        "settings": { "paddingY": "3.5rem", "gap": "1.5rem", "columns": 1 },
        "elements": [
          {
            "id": "c_up_steps",
            "elType": "column",
            "settings": { "width": 100 },
            "elements": [
              {
                "id": "w_up_steps",
                "elType": "widget",
                "widgetType": "steps-row",
                "settings": {
                  "animate": true,
                  "show_line": true,
                  "items": [
                    { "badge": "1", "title": "Backup", "text": "Snapshot files and database before applying any update ZIP." },
                    { "badge": "2", "title": "Apply", "text": "Upload/apply the release via admin updater or MCP cms_release pipeline." },
                    { "badge": "3", "title": "Migrate", "text": "Run pending migrations if the release includes schema changes." },
                    { "badge": "4", "title": "Verify", "text": "Hard-refresh the admin (Ctrl+F5), smoke public pages, check diagnostics." }
                  ]
                }
              },
              {
                "id": "w_up_grid",
                "elType": "widget",
                "widgetType": "features-grid",
                "settings": {
                  "title": "What the updater protects",
                  "subtitle": "Operational realities of the framework.",
                  "columns": 3,
                  "items": [
                    { "icon": "refresh", "title": "Asset prune", "body": "Stale hashed frontend files are cleaned after a successful update." },
                    { "icon": "bug", "title": "Module quarantine", "body": "A broken ZIP module can isolate instead of killing the API process." },
                    { "icon": "shield", "title": "Config stays local", "body": "Hosting secrets are not overwritten by the public release package." }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "id": "s_up_cta",
        "elType": "section",
        "settings": { "paddingY": "3.5rem", "gap": "1.5rem", "columns": 1 },
        "elements": [
          {
            "id": "c_up_cta",
            "elType": "column",
            "settings": { "width": 100 },
            "elements": [
              {
                "id": "w_up_cta",
                "elType": "widget",
                "widgetType": "cta-banner",
                "settings": {
                  "title": "Need the install baseline?",
                  "subtitle": "Fresh sites start from the install release tag.",
                  "cta_label": "Install ZIP",
                  "cta_href": "https://github.com/iia3uk/jasefly/releases/tag/install"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
