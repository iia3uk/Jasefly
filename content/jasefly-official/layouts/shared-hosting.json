                "id": "w_36",
                "elType": "widget",
                "widgetType": "text",
                "settings": {
                  "html": "<p><strong>Требования production:</strong> PHP 8.2+, MySQL, Apache или Nginx, HTTPS, возможность загрузить ZIP.</p>",
