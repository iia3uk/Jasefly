              "elType": "widget",
              "widgetType": "text",
              "settings": {
                "html": "<p>Every new PHP product starts the same way.</p><p>Pick a backend framework.</p><p>Then an admin.</p><p>Then a builder.</p><p>Then ACL.</p><p>Then updates.</p><p>Then a package lifecycle.</p><p>Then docs.</p><p>Then AI glue.</p><p>Weeks disappear into infrastructure — before the product exists.</p><p>Jasefly exists because that platform was built once.</p><p>Now the work is the product.</p>",
                "align": "left"
              },
              "elements": []
            }
