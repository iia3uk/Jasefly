{
  "schema_version": 1,
  "type": "jasefly-module",
  "name": "Jasefly Character",
  "slug": "jasefly-character",
  "version": "1.6.0",
  "description": "Дух CMS: короткие реплики, тишина, умный гид, разовые пасхалки, chase/flee.",
  "author": {
    "name": "Jasefly",
    "url": "https://jasefly.com"
  },
  "license": "MIT",
  "jasefly": {
    "min_version": "1.0.0",
    "api_version": 1,
    "sdk_version": 1
  },
  "php": {
    "min_version": "8.1",
    "extensions": ["json"]
  },
  "dependencies": {
    "required": {
      "system": ">=1.0.0"
    },
    "optional": {},
    "conflicts": {}
  },
  "capabilities": {
    "requires": [
      "api.routes",
      "admin.pages",
      "permissions.check",
      "settings.module"
    ],
    "provides": ["jasefly-character.mascot"]
  },
  "entrypoints": {
    "backend": "backend/JaseflyCharacterModule.php",
    "frontend_manifest": "frontend-dist/manifest.json"
  },
  "migrations": {
    "path": "migrations",
    "namespace": "jasefly-character",
    "uninstall_path": "migrations/uninstall"
  },
  "permissions": [
    "jasefly-character.view",
    "jasefly-character.manage"
  ],
  "install": {
    "preserve_data_on_uninstall": true,
    "allow_downgrade": false
  },
  "hooks": {
    "after_install": "hooks/PostInstallHook.php"
  }
}
