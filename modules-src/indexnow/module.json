{
  "schema_version": 1,
  "type": "jasefly-module",
  "name": "IndexNow",
  "slug": "indexnow",
  "version": "1.0.2",
  "description": "Протокол IndexNow: Bing/Яндекс/Seznam, ключ верификации, автоотправка с rate-limit (без долбёжки 429), журнал.",
  "author": {
    "name": "Jasefly",
    "url": "https://jasefly.com"
  },
  "license": "MIT",
  "jasefly": {
    "min_version": "1.0.0",
    "api_version": 1,
    "sdk_version": 1
  },
  "php": {
    "min_version": "8.1",
    "extensions": ["curl", "json"]
  },
  "dependencies": {
    "required": {
      "system": ">=1.0.0"
    },
    "optional": {},
    "conflicts": {}
  },
  "capabilities": {
    "requires": [
      "http.client",
      "api.routes",
      "admin.pages",
      "permissions.check",
      "settings.module",
      "events.subscribe",
      "storage.files"
    ],
    "provides": ["indexnow.submit"]
  },
  "entrypoints": {
    "backend": "backend/IndexNowModule.php",
    "frontend_manifest": "frontend-dist/manifest.json"
  },
  "migrations": {
    "path": "migrations",
    "namespace": "indexnow",
    "uninstall_path": "migrations/uninstall"
  },
  "permissions": [
    "indexnow.view",
    "indexnow.manage",
    "indexnow.submit"
  ],
  "install": {
    "preserve_data_on_uninstall": true,
    "allow_downgrade": false
  },
  "hooks": {
    "after_install": "hooks/PostInstallHook.php"
  }
}
