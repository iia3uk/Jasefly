{
  "schema_version": 1,
  "type": "jasefly-module",
  "name": "Wallet",
  "slug": "wallet",
  "version": "0.1.0",
  "description": "Каркас кошелька / кредитов + Access Provider wallet (min_balance). Билдер не ходит в wallet API напрямую.",
  "author": {
    "name": "Jasefly CMS",
    "url": "https://jasefly.com"
  },
  "license": "MIT",
  "jasefly": {
    "min_version": "1.0.0",
    "api_version": 1,
    "sdk_version": 1
  },
  "php": {
    "min_version": "8.1",
    "extensions": []
  },
  "dependencies": {
    "required": {
      "system": ">=1.0.0"
    },
    "optional": {},
    "conflicts": {}
  },
  "capabilities": {
    "requires": [
      "access.service",
      "api.routes",
      "admin.pages",
      "permissions.check",
      "http.client"
    ],
    "provides": ["access.provider.wallet"]
  },
  "entrypoints": {
    "backend": "backend/WalletModule.php",
    "frontend_manifest": "frontend-dist/manifest.json"
  },
  "migrations": {
    "path": "migrations",
    "namespace": "wallet",
    "uninstall_path": "migrations/uninstall"
  },
  "permissions": [
    "wallet.view",
    "wallet.manage"
  ],
  "install": {
    "preserve_data_on_uninstall": true,
    "allow_downgrade": false
  }
}
