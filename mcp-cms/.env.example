# Jasefly CMS MCP — ALL secrets live here (not in mcp.json).
# This file is gitignored. Never commit real tokens.

# Remote site
CMS_URL=https://YOUR_DOMAIN

# Same value as site api/config/.env → MCP_API_TOKEN
CMS_MCP_TOKEN=YOUR_MCP_TOKEN

# Local repo for build/test/deploy gate
CMS_REPO_ROOT=C:/JASEFLY_CMS

# Optional fallback login (prefer token)
# CMS_EMAIL=
# CMS_PASSWORD=
# CMS_TOTP_CODE=

# Optional PHP binary for local php -l tests
# PHP_BIN=php

# Shared-hosting safety (default ON)
# CMS_HOSTING_SAFE=1
# Min pause between remote HTTP calls (ms)
CMS_MIN_INTERVAL_MS=2000
# Hard cap remote calls per rolling minute
CMS_MAX_PER_MINUTE=15
# Cache identical GET responses (ms); mutations clear cache
CMS_CACHE_TTL_MS=90000
