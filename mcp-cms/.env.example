# Jasefly CMS MCP — ALL secrets live here (not in mcp.json).
# This file is gitignored. Never commit real tokens.

# ─── Option A: один сайт (legacy) ───────────────────────────────────────────
CMS_URL=https://YOUR_DOMAIN
# Same value as site api/config/.env → MCP_API_TOKEN
CMS_MCP_TOKEN=YOUR_MCP_TOKEN
# Same as site MCP_SIGNING_SECRET (HMAC; never sent as Bearer). Required when site MCP_AUTH_MODE=require.
# CMS_MCP_SIGNING_SECRET=YOUR_SIGNING_SECRET

# ─── Option B: несколько сайтов (один MCP-процесс) ───────────────────────────
# Добавить/убрать хост = только этот файл (+ CMS_SITES). НЕ правь src/sites.js.
# Раскомментируй CMS_SITES и блоки CMS_SITE_* — тогда remote-tools требуют
# параметр site=id|alias|domain (cms_sites — список). При одном сайте site опционален.
#
# CMS_SITES=jasefly,iia3uk
#
# CMS_SITE_JASEFLY_URL=https://jasefly.com
# CMS_SITE_JASEFLY_TOKEN=YOUR_TOKEN_JASEFLY
# CMS_SITE_JASEFLY_SIGNING_SECRET=YOUR_SIGNING_JASEFLY
# CMS_SITE_JASEFLY_ALIASES=jasefly.com,www.jasefly.com,official
#
# CMS_SITE_IIA3UK_URL=https://iia3uk.ru
# CMS_SITE_IIA3UK_TOKEN=YOUR_TOKEN_IIA3UK
# CMS_SITE_IIA3UK_SIGNING_SECRET=YOUR_SIGNING_IIA3UK
# CMS_SITE_IIA3UK_ALIASES=iia3uk.ru,www.iia3uk.ru

# Dual-runtime (optional per site; default php-shared / shared)
# CMS_SITE_JASEFLY_RUNTIME=php-shared
# CMS_SITE_JASEFLY_DEPLOYMENT=shared
#
# VPS Node example (no PHP on server):
# CMS_SITE_VPSDEMO_RUNTIME=node-vps
# CMS_SITE_VPSDEMO_DEPLOYMENT=vps
# CMS_SITE_VPSDEMO_URL=https://vps.example.com
# CMS_SITE_VPSDEMO_TOKEN=…
# CMS_SITE_VPSDEMO_DEPLOY_PATH=/var/www/jasefly
# CMS_SITE_VPSDEMO_SSH_HOST=vps.example.com
# CMS_SITE_VPSDEMO_SSH_USER=deploy
# CMS_SITE_VPSDEMO_SSH_KEY_PATH=C:/Users/you/.ssh/id_ed25519
# CMS_SITE_VPSDEMO_RESTART_COMMAND=sudo systemctl restart jasefly-node
# CMS_SITE_VPSDEMO_HEALTHCHECK_URL=https://vps.example.com/api/v1/health
# CMS_SITE_VPSDEMO_PROCESS_MANAGER=systemd

# Local repo for build/test/deploy gate
CMS_REPO_ROOT=F:/JASEFLY_CMS

# Optional fallback login (prefer token) — only for Option A / per-site EMAIL vars
# CMS_EMAIL=
# CMS_PASSWORD=
# CMS_TOTP_CODE=
# Per-site: CMS_SITE_JASEFLY_EMAIL / _PASSWORD / _TOTP_CODE

# Optional PHP binary for local php -l tests
# PHP_BIN=php

# Shared-hosting safety (default ON) — applies per site (separate HostingGuard)
# CMS_HOSTING_SAFE=1
# Min pause between remote HTTP calls (ms)
CMS_MIN_INTERVAL_MS=2000
# Hard cap remote calls per rolling minute
CMS_MAX_PER_MINUTE=15
# Cache identical GET responses (ms); mutations clear cache
CMS_CACHE_TTL_MS=90000
